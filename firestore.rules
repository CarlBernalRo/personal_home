rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()            { return request.auth != null; }
    function isOwner(uid)        { return request.auth.uid == uid; }
    function isHouseholdMember(hId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/households/$(hId)) &&
        request.auth.uid in
          get(/databases/$(database)/documents/households/$(hId)).data.members;
    }
    // A non-member joining via invite code: the write may only add their own
    // uid to members/memberNames, nothing else — rename/delete still require
    // already being a member.
    function isJoiningHousehold() {
      return isAuth() &&
        !(request.auth.uid in resource.data.members) &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'memberPhotos']);
    }

    // The single admin signs in with username/password (Auth email below, password
    // provider). Integrantes sign in with Google, so they can never match this.
    function isAdmin() {
      return isAuth() &&
        request.auth.token.email == 'admin@gastoshogar.local' &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Whitelist — any authenticated user can read (login check); only the admin writes
    match /allowedUsers/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // Roles
    match /roles/{roleId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Households — read is open to any authenticated (whitelisted) user because
    // joining by invite code requires reading the doc *before* you're a member;
    // the code itself is the access control for discovery. Only members can
    // write, except a non-member adding themselves via a valid invite code.
    match /households/{householdId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isHouseholdMember(householdId) || isJoiningHousehold();
      allow delete: if isAuth() &&
        get(/databases/$(database)/documents/households/$(householdId)).data.createdBy == request.auth.uid;
    }

    // Variable expenses — owner only
    match /expenses/{id} {
      allow read, delete: if isAuth() && isOwner(resource.data.userId);
      allow create:       if isAuth() && isOwner(request.resource.data.userId);
      allow update:       if isAuth() && isOwner(resource.data.userId);
    }

    // Fixed expenses
    match /fixedExpenses/{id} {
      allow read, delete: if isAuth() && isOwner(resource.data.userId);
      allow create:       if isAuth() && isOwner(request.resource.data.userId);
      allow update:       if isAuth() && isOwner(resource.data.userId);
    }

    // Fixed expense payment records
    match /fixedExpensePayments/{id} {
      allow read, delete: if isAuth() && isOwner(resource.data.userId);
      allow create:       if isAuth() && isOwner(request.resource.data.userId);
      allow update:       if isAuth() && isOwner(resource.data.userId);
    }

    // Movements read from a Telegram screenshot: created by the bot (server side), confirmed or discarded by their owner in the app
    match /pendingMovements/{id} {
      allow read, update, delete: if isAuth() && isOwner(resource.data.userId);
    }

    // Small copies of receipts: the ones from Telegram are created by the bot, the ones attached by hand by their owner
    // (only small images: the picture travels inside the document as base64)
    match /attachments/{id} {
      allow read:         if isAuth() && (isOwner(resource.data.userId) || request.auth.uid in resource.data.get('sharedWith', []));
      allow delete:       if isAuth() && isOwner(resource.data.userId);
      allow create:       if isAuth() && isOwner(request.resource.data.userId)
                          && request.resource.data.source == 'app'
                          && request.resource.data.mime.matches('image/.*')
                          && request.resource.data.data is string
                          && request.resource.data.data.size() < 900000;
    }

    // Money moved between a user's own accounts
    match /accountTransfers/{id} {
      allow read, delete: if isAuth() && isOwner(resource.data.userId);
      allow create:       if isAuth() && isOwner(request.resource.data.userId);
    }

    // Incomes
    match /incomes/{id} {
      allow read, delete: if isAuth() && isOwner(resource.data.userId);
      allow create:       if isAuth() && isOwner(request.resource.data.userId);
      allow update:       if isAuth() && isOwner(resource.data.userId);
    }

    // Accounts
    match /accounts/{id} {
      allow read, delete: if isAuth() && isOwner(resource.data.userId);
      allow create:       if isAuth() && isOwner(request.resource.data.userId);
      allow update:       if isAuth() && isOwner(resource.data.userId);
    }

    // Savings goals
    match /savingsGoals/{id} {
      allow read, delete: if isAuth() && isOwner(resource.data.userId);
      allow create:       if isAuth() && isOwner(request.resource.data.userId);
      allow update:       if isAuth() && isOwner(resource.data.userId);
    }

    // Household debts — household members only
    match /householdDebts/{id} {
      allow read:           if isHouseholdMember(resource.data.householdId);
      allow create:         if isAuth() && isHouseholdMember(request.resource.data.householdId);
      allow update, delete: if isHouseholdMember(resource.data.householdId);
    }

    // Household crossings — household members only
    match /householdCrossings/{id} {
      allow read:   if isHouseholdMember(resource.data.householdId);
      allow create: if isAuth() && isHouseholdMember(request.resource.data.householdId);
      allow delete: if isHouseholdMember(resource.data.householdId);
    }

    // Household expenses (shared purchases that auto-split into householdDebts)
    match /householdExpenses/{id} {
      allow read:           if isHouseholdMember(resource.data.householdId);
      allow create:         if isAuth() && isHouseholdMember(request.resource.data.householdId);
      allow update, delete: if isHouseholdMember(resource.data.householdId);
    }
    // Notifications — each one belongs to its recipient; anyone signed in may create one, but only as themselves
    match /notifications/{id} {
      allow read, update, delete: if isAuth() && isOwner(resource.data.userId);
      allow create:              if isAuth() && request.resource.data.fromUid == request.auth.uid;
    }

    // Household invitations — made by a member, answered by the invited e-mail
    match /householdInvites/{id} {
      allow read:   if isAuth() && (request.auth.token.email.lower() == resource.data.email || isHouseholdMember(resource.data.householdId));
      allow create: if isAuth() && isHouseholdMember(request.resource.data.householdId) && request.resource.data.invitedBy == request.auth.uid;
      allow update: if isAuth() && request.auth.token.email.lower() == resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if isAuth() && (request.auth.token.email.lower() == resource.data.email || isHouseholdMember(resource.data.householdId));
    }
  }
}
